# KING CAMERA SHOP — Server Environment Variables
# Cloud SQL runtime variables (SQL_HOST, SQL_USER, SQL_PASSWORD, SQL_DB_NAME,
# SQL_ADMIN_USER, SQL_ADMIN_PASSWORD) are provisioned automatically by Cloud SQL.

# Authentication & Session Signing (Server-side only)
AUTH_TOKEN_SECRET=
ADMIN_BOOTSTRAP_SECRET=

# Payment Channel (Strictly Server-Side — Never Exposed to Client)
TRUEMONEY_OWNER_PHONE=

# Public Application URL
APP_URL=
